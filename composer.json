{
    "name": "reviactyl/panel",
    "version": "26.0.0-dev",
    "description": "The free, open-source game management panel. Supporting Minecraft, Spigot, BungeeCord, and SRCDS servers.",
    "license": "MIT",
    "require": {
        "php": "^8.3 || ^8.4 || ^8.5",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-posix": "*",
        "ext-zip": "*",
        "aws/aws-sdk-php": "3.387.2",
        "dedoc/scramble": "0.13.47",
        "filament/filament": "5.10.1",
        "guzzlehttp/guzzle": "7.16.1",
        "hashids/hashids": "5.0.2",
        "laracasts/utilities": "3.2.5",
        "laravel/framework": "13.40.0",
        "laravel/helpers": "1.8.3",
        "laravel/passkeys": "0.2.1",
        "laravel/sanctum": "4.3.2",
        "laravel/socialite": "5.28.0",
        "laravel/tinker": "3.0.2",
        "laravel/ui": "4.6.3",
        "lcobucci/jwt": "5.6.0",
        "league/flysystem-aws-s3-v3": "3.35.1",
        "league/flysystem-memory": "3.31.0",
        "matriphe/iso-639": "2.0.10",
        "phiki/phiki": "2.2.0",
        "phpseclib/phpseclib": "3.0.57",
        "pragmarx/google2fa": "8.0.3",
        "predis/predis": "3.5.1",
        "prologue/alerts": "1.4.0",
        "psr/cache": "3.0.0",
        "s1lentium/iptools": "1.2.0",
        "secondnetwork/blade-tabler-icons": "3.44.0",
        "socialiteproviders/discord": "4.2.0",
        "spatie/laravel-fractal": "6.4.0",
        "spatie/laravel-query-builder": "6.4.4",
        "staudenmeir/belongs-to-through": "2.18",
        "symfony/http-client": "7.4.14",
        "symfony/mailgun-mailer": "7.4.14",
        "symfony/postmark-mailer": "7.4.13",
        "symfony/yaml": "7.4.18",
        "webmozart/assert": "1.12.1"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "3.7.0",
        "fakerphp/faker": "1.24.1",
        "filament/upgrade": "5.10.1",
        "itsgoingd/clockwork": "5.3.5",
        "larastan/larastan": "3.10.0",
        "laravel/pint": "1.29.3",
        "mockery/mockery": "1.6.15",
        "nunomaduro/collision": "8.9.4",
        "pestphp/pest": "4.7.4",
        "phpstan/phpstan": "2.2.3",
        "phpstan/phpstan-webmozart-assert": "2.0.0",
        "spatie/laravel-ignition": "2.12.0"
    },
    "autoload": {
        "files": [
            "app/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/Factories/",
            "Database\\Seeders\\": "database/Seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "pint:fix": "./vendor/bin/pint",
        "pint:check": "./vendor/bin/pint --test -v",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi || true",
            "@php artisan filament:upgrade"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
